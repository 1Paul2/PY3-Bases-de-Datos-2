                  name="SqlCommand"
                  UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">SELECT
    customer_id AS CustomerID,
    CAST(first_name + ' ' + last_name AS NVARCHAR(120)) AS NombreCompleto,
    CAST(email AS NVARCHAR(255)) AS Email,
    CAST(ISNULL(phone, 'Sin teléfono') AS NVARCHAR(25)) AS Telefono,
    CAST(street AS NVARCHAR(255)) AS Calle,
    CAST(city AS NVARCHAR(50))  AS Ciudad,
    CAST(state AS NVARCHAR(25))  AS Estado,
    CAST(zip_code AS NVARCHAR(10))  AS CodigoPostal
FROM sales.customers;</property>
                <property
