            WHEN 1 THEN 'Pendiente'
            WHEN 2 THEN 'En proceso'
            WHEN 3 THEN 'Rechazada'
            WHEN 4 THEN 'Completada'
         END AS NVARCHAR(20)) AS EstadoOrden
FROM sales.orders;</property>
