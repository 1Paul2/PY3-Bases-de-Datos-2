                  description="Comando SQL para ejecutar."
                  name="SqlCommand"
                  UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">SELECT
    p.product_id AS ProductID,
    CAST(p.product_name  AS NVARCHAR(255)) AS NombreProducto,
    CAST(b.brand_name AS NVARCHAR(255)) AS Marca,
    CAST(c.category_name AS NVARCHAR(255)) AS Categoria,
    p.model_year  AS AnioModelo,
    p.list_price  AS PrecioLista
FROM production.products p
JOIN production.brands     b ON b.brand_id    = p.brand_id
JOIN production.categories c ON c.category_id = p.category_id;</property>
