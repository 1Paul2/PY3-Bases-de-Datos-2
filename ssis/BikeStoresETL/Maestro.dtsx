        <SQLTask:SqlTaskData
          SQLTask:Connection="{2BBB1A40-EC18-4950-BAB8-5A0ADFEE501D}"
          SQLTask:SqlStatementSource="&#xA;&#xA;/* ---------- Dimensiones  ---------- */&#xA;&#xA;IF OBJECT_ID('dbo.DimFecha', 'U') IS NULL&#xA;BEGIN&#xA;    CREATE TABLE dbo.DimFecha (&#xA;        FechaKey        INT          NOT NULL PRIMARY KEY,  -- AAAAMMDD, -1 = sin fecha&#xA;        Fecha           DATE         NULL,&#xA;        Dia             TINYINT      NULL,&#xA;        Mes             TINYINT      NULL,&#xA;        NombreMes       NVARCHAR(20) NULL,&#xA;        Trimestre       TINYINT      NULL,&#xA;        Anio            SMALLINT     NULL,&#xA;        DiaSemana       TINYINT      NULL,&#xA;        NombreDia       NVARCHAR(20) NULL,&#xA;        EsFinDeSemana   BIT          NULL&#xA;    );&#xA;END;&#xA;&#xA;IF OBJECT_ID('dbo.DimCliente', 'U') IS NULL&#xA;BEGIN&#xA;    CREATE TABLE dbo.DimCliente (                        -- SCD TIPO 2&#xA;        ClienteKey      INT IDENTITY(1,1) NOT NULL PRIMARY KEY,&#xA;        CustomerID      INT           NOT NULL,&#xA;        NombreCompleto  NVARCHAR(120) NOT NULL,&#xA;        Email           NVARCHAR(255) NULL,&#xA;        Telefono        NVARCHAR(25)  NULL,&#xA;        Calle           NVARCHAR(255) NULL,&#xA;        Ciudad          NVARCHAR(50)  NULL,&#xA;        Estado          NVARCHAR(25)  NULL,&#xA;        CodigoPostal    NVARCHAR(10)  NULL,&#xA;        FechaInicio     DATE          NOT NULL,&#xA;        FechaFin        DATE          NULL,&#xA;        EsActual        BIT           NOT NULL DEFAULT 1&#xA;    );&#xA;END;&#xA;&#xA;IF OBJECT_ID('dbo.DimProducto', 'U') IS NULL&#xA;BEGIN&#xA;    CREATE TABLE dbo.DimProducto (                       -- SCD TIPO 2&#xA;        ProductoKey     INT IDENTITY(1,1) NOT NULL PRIMARY KEY,&#xA;        ProductID       INT            NOT NULL,&#xA;        NombreProducto  NVARCHAR(255)  NOT NULL,&#xA;        Marca           NVARCHAR(255)  NOT NULL,&#xA;        Categoria       NVARCHAR(255)  NOT NULL,&#xA;        AnioModelo      SMALLINT       NULL,&#xA;        PrecioLista     DECIMAL(10,2)  NULL,&#xA;        FechaInicio     DATE           NOT NULL,&#xA;        FechaFin        DATE           NULL,&#xA;        EsActual        BIT            NOT NULL DEFAULT 1&#xA;    );&#xA;END;&#xA;&#xA;IF OBJECT_ID('dbo.DimTienda', 'U') IS NULL&#xA;BEGIN&#xA;    CREATE TABLE dbo.DimTienda (                         -- SCD TIPO 1&#xA;        TiendaKey       INT IDENTITY(1,1) NOT NULL PRIMARY KEY,&#xA;        StoreID         INT           NOT NULL,&#xA;        NombreTienda    NVARCHAR(255) NOT NULL,&#xA;        Telefono        NVARCHAR(25)  NULL,&#xA;        Email           NVARCHAR(255) NULL,&#xA;        Calle           NVARCHAR(255) NULL,&#xA;        Ciudad          NVARCHAR(255) NULL,&#xA;        Estado          NVARCHAR(10)  NULL,&#xA;        CodigoPostal    NVARCHAR(5)   NULL&#xA;    );&#xA;END;&#xA;&#xA;IF OBJECT_ID('dbo.DimEmpleado', 'U') IS NULL&#xA;BEGIN&#xA;    CREATE TABLE dbo.DimEmpleado (                       -- SCD TIPO 1&#xA;        EmpleadoKey     INT IDENTITY(1,1) NOT NULL PRIMARY KEY,&#xA;        StaffID         INT           NOT NULL,&#xA;        NombreCompleto  NVARCHAR(120) NOT NULL,&#xA;        Email           NVARCHAR(255) NULL,&#xA;        Telefono        NVARCHAR(25)  NULL,&#xA;        Activo          BIT           NULL,&#xA;        NombreTienda    NVARCHAR(255) NULL,&#xA;        NombreJefe      NVARCHAR(120) NULL&#xA;    );&#xA;END;&#xA;&#xA;IF OBJECT_ID('dbo.DimOrden', 'U') IS NULL&#xA;BEGIN&#xA;    CREATE TABLE dbo.DimOrden (                          -- SCD TIPO 1&#xA;        OrdenKey        INT IDENTITY(1,1) NOT NULL PRIMARY KEY,&#xA;        OrderID         INT          NOT NULL,&#xA;        CodigoEstado    TINYINT      NOT NULL,&#xA;        EstadoOrden     NVARCHAR(20) NOT NULL&#xA;    );&#xA;END;&#xA;&#xA;/* ---------- Hechos ---------- */&#xA;&#xA;IF OBJECT_ID('dbo.FactVentas', 'U') IS NULL&#xA;BEGIN&#xA;    CREATE TABLE dbo.FactVentas (&#xA;        VentaKey             BIGINT IDENTITY(1,1) NOT NULL PRIMARY KEY,&#xA;        OrdenKey             INT NOT NULL REFERENCES dbo.DimOrden(OrdenKey),&#xA;        ClienteKey           INT NOT NULL REFERENCES dbo.DimCliente(ClienteKey),&#xA;        ProductoKey          INT NOT NULL REFERENCES dbo.DimProducto(ProductoKey),&#xA;        TiendaKey            INT NOT NULL REFERENCES dbo.DimTienda(TiendaKey),&#xA;        EmpleadoKey          INT NOT NULL REFERENCES dbo.DimEmpleado(EmpleadoKey),&#xA;        FechaOrdenKey        INT NOT NULL REFERENCES dbo.DimFecha(FechaKey),&#xA;        FechaRequeridaKey    INT NOT NULL REFERENCES dbo.DimFecha(FechaKey),&#xA;        FechaEnvioKey        INT NOT NULL REFERENCES dbo.DimFecha(FechaKey),&#xA;        OrderID              INT NOT NULL,&#xA;        ItemID               INT NOT NULL,&#xA;        Cantidad             INT           NOT NULL,&#xA;        PrecioUnitario       DECIMAL(10,2) NOT NULL,&#xA;        PorcentajeDescuento  DECIMAL(4,2)  NOT NULL,&#xA;        MontoBruto           DECIMAL(12,2) NOT NULL,&#xA;        MontoDescuento       DECIMAL(12,2) NOT NULL,&#xA;        MontoNeto            DECIMAL(12,2) NOT NULL&#xA;    );&#xA;END;&#xA;&#xA;IF OBJECT_ID('dbo.FactInventario', 'U') IS NULL&#xA;BEGIN&#xA;    CREATE TABLE dbo.FactInventario (&#xA;        InventarioKey   BIGINT IDENTITY(1,1) NOT NULL PRIMARY KEY,&#xA;        ProductoKey     INT NOT NULL REFERENCES dbo.DimProducto(ProductoKey),&#xA;        TiendaKey       INT NOT NULL REFERENCES dbo.DimTienda(TiendaKey),&#xA;        FechaCargaKey   INT NOT NULL REFERENCES dbo.DimFecha(FechaKey),&#xA;        Cantidad        INT NOT NULL&#xA;    );&#xA;END;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\Limpiar inventario de hoy"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Tarea Ejecutar SQL"
      DTS:DTSID="{3CE396ED-8E90-487A-AC68-DA0E48EAE799}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Limpiar inventario de hoy"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{2BBB1A40-EC18-4950-BAB8-5A0ADFEE501D}"
          SQLTask:SqlStatementSource="DELETE FROM dbo.FactInventario&#xA;WHERE FechaCargaKey = YEAR(GETDATE())*10000 + MONTH(GETDATE())*100 + DAY(GETDATE());" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\Poblar DimFecha"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Tarea Ejecutar SQL"
      DTS:DTSID="{76783883-63DF-4D0D-A37A-64259A57D1F1}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Poblar DimFecha"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{2BBB1A40-EC18-4950-BAB8-5A0ADFEE501D}"
          SQLTask:SqlStatementSource="SET LANGUAGE Spanish;&#xA;SET DATEFIRST 1;&#xA;&#xA;DECLARE @Inicio DATE = '2016-01-01';&#xA;DECLARE @Fin    DATE = '2026-12-31';&#xA;&#xA;IF NOT EXISTS (SELECT 1 FROM dbo.DimFecha WHERE FechaKey = -1)&#xA;    INSERT INTO dbo.DimFecha (FechaKey, Fecha, NombreMes, NombreDia)&#xA;    VALUES (-1, NULL, N'Sin fecha', N'Sin fecha');&#xA;&#xA;WITH Dias AS (&#xA;    SELECT @Inicio AS Fecha&#xA;    UNION ALL&#xA;    SELECT DATEADD(DAY, 1, Fecha) FROM Dias WHERE Fecha &lt; @Fin&#xA;)&#xA;INSERT INTO dbo.DimFecha&#xA;      (FechaKey, Fecha, Dia, Mes, NombreMes, Trimestre, Anio,&#xA;       DiaSemana, NombreDia, EsFinDeSemana)&#xA;SELECT YEAR(Fecha)*10000 + MONTH(Fecha)*100 + DAY(Fecha),&#xA;       Fecha, DAY(Fecha), MONTH(Fecha), DATENAME(MONTH, Fecha),&#xA;       DATEPART(QUARTER, Fecha), YEAR(Fecha),&#xA;       DATEPART(WEEKDAY, Fecha), DATENAME(WEEKDAY, Fecha),&#xA;       CASE WHEN DATEPART(WEEKDAY, Fecha) IN (6,7) THEN 1 ELSE 0 END&#xA;FROM Dias d&#xA;WHERE NOT EXISTS (SELECT 1 FROM dbo.DimFecha f WHERE f.Fecha = d.Fecha)&#xA;OPTION (MAXRECURSION 0);" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
  </DTS:Executables>
