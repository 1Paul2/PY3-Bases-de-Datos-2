                  description="Especifica la variable que contiene el nombre del objeto de base de datos usado para abrir un conjunto de filas."
                  name="OpenRowsetVariable"></property>
                <property
                  dataType="System.String"
                  description="Comando SQL para ejecutar."
                  name="SqlCommand"
                  UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">SELECT
    oi.order_id   AS OrderID,
    oi.item_id    AS ItemID,
    o.customer_id AS CustomerID,
    oi.product_id AS ProductID,
    o.store_id  AS StoreID,
    o.staff_id  AS StaffID,
    YEAR(o.order_date)*10000 + MONTH(o.order_date)*100 + DAY(o.order_date) AS FechaOrdenKey,
    YEAR(o.required_date)*10000 + MONTH(o.required_date)*100 + DAY(o.required_date) AS FechaRequeridaKey,
    ISNULL(YEAR(o.shipped_date)*10000 + MONTH(o.shipped_date)*100 + DAY(o.shipped_date), -1) AS FechaEnvioKey,
    oi.quantity AS Cantidad,
    oi.list_price AS PrecioUnitario,
    oi.discount   AS PorcentajeDescuento
FROM sales.order_items oi
JOIN sales.orders o ON o.order_id = oi.order_id;</property>
                <property
