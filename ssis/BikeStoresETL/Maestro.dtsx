                  description="Especifica la variable que contiene el nombre del objeto de base de datos usado para abrir un conjunto de filas."
                  name="OpenRowsetVariable"></property>
                <property
                  dataType="System.String"
                  description="Comando SQL para ejecutar."
                  name="SqlCommand"
                  UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">SELECT
    s.staff_id AS StaffID,
    CAST(s.first_name + ' ' + s.last_name AS NVARCHAR(120)) AS NombreCompleto,
    CAST(s.email AS NVARCHAR(255))  AS Email,
    CAST(ISNULL(s.phone, 'Sin teléfono') AS NVARCHAR(25)) AS Telefono,
    CAST(s.active AS BIT) AS Activo,
    CAST(st.store_name AS NVARCHAR(255)) AS NombreTienda,
    CAST(ISNULL(m.first_name + ' ' + m.last_name, 'Sin jefe') AS NVARCHAR(120)) AS NombreJefe
FROM sales.staffs s
JOIN sales.stores st ON st.store_id = s.store_id
LEFT JOIN sales.staffs m ON m.staff_id  = s.manager_id;</property>
